# google-registry local (suba com --port 8003, a 8000 é deste serviço).
# Em QA o Infisical expõe a mesma URL como GOOGLE_REGISTRY_URL, que também é aceita.
REGISTRY_URL=http://localhost:8003
REGISTRY_CONSUMER_TOKEN=your-registry-consumer-token-here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# Telemetria: desligada por padrão. Ver a seção Telemetria da documentação.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=ai-validation
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
